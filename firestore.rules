rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile document users/{uid} — admin can list all users
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.email == 'lengocthang.mb@gmail.com');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user data subcollections — owner or admin can read/write
    match /users/{uid}/{col}/{docId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.email == 'lengocthang.mb@gmail.com');
    }

    // Registered users — each user writes their own, admin reads all
    match /registeredUsers/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.email == 'lengocthang.mb@gmail.com');
    }

    // Shared settings (usdRate) — all logged-in users read, only admin writes
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'lengocthang.mb@gmail.com';
    }

  }
}
